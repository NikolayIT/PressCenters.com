{
  "profiles": {
    "Convert thumbnails to WebP and delete the PNGs": {
      "commandName": "Project",
      "commandLineArgs": "sandbox",
      "environmentVariables": {
        "IMAGES_WEBP": "1",
        "IMAGES_WEBP_DELETE_PNG": "1"
      }
    },
    "Convert thumbnails to WebP (trial: 200 newest, keeps the PNGs)": {
      "commandName": "Project",
      "commandLineArgs": "sandbox",
      "environmentVariables": {
        "IMAGES_WEBP": "1",
        "IMAGES_WEBP_LIMIT": "200"
      }
    },
    "Backfill news (GetAllNewsSandbox)": {
      "commandName": "Project",
      "commandLineArgs": "sandbox"
    },
    "Download missing thumbnails (DownloadImagesSandbox)": {
      "commandName": "Project",
      "commandLineArgs": "sandbox",
      "environmentVariables": {
        "IMAGES_BACKFILL": "1"
      }
    }
  }
}
